<Project>
  <!-- Projucer cannot set JUCE_VST3_CAN_REPLACE_VST2 through its UI in this version,
       so this file injects it for all projects. MSBuild imports this automatically. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>JUCE_VST3_CAN_REPLACE_VST2=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
